{
  "name": "dev-in-situ",
  "version": "0.3.0",
  "description": "Local bridge that hands in-page edit requests to any AI coding agent CLI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dev-in-situ": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test --test-concurrency=1 \"test/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NabilAldhamari/dev-in-situ.git",
    "directory": "daemon"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "browser-extension",
    "claude-code",
    "codex",
    "gemini"
  ],
  "files": [
    "dist"
  ]
}
